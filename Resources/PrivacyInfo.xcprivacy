<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Pocket Beings privacy manifest.

	  No network layer: no analytics, no crash reporter, no ads, no accounts,
	  no server. The town is one JSON file in the app group container, shared
	  only with this app's own widget. UserDefaults holds the player's charges,
	  purchases and settings (CA92.1), and two flags the widget reads through
	  the app group (1C8F.1).
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key><string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key><array><string>CA92.1</string><string>1C8F.1</string></array>
		</dict>
	</array>
</dict>
</plist>
